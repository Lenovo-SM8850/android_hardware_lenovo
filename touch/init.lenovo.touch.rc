on post-fs-data
    chown system system /proc/gesture_mode
    chmod 0660 /proc/gesture_mode
    chown system system /proc/panel_direction
    chmod 0644 /proc/panel_direction
    chown system system /proc/edge_grid_zone
    chmod 0644 /proc/edge_grid_zone
