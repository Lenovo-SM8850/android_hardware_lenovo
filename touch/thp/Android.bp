// SPDX-License-Identifier: Apache-2.0

cc_binary {
    name: "thpd",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    srcs: ["main.cpp"],
    init_rc: ["thpd.rc"],
    shared_libs: [
        "libdl",
        "liblog",
    ],
    stl: "none",
    // Let the stock AFE's ioctl@LIBC binding observe cmd101 in the host.
    ldflags: ["-Wl,--export-dynamic-symbol=ioctl"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_binary {
    name: "thpd-goodix-recovery",
    recovery: true,
    required: ["init.recovery.goodix-touch.rc"],
    compile_multilib: "64",
    srcs: ["main.cpp"],
    shared_libs: [
        "libdl",
        "liblog",
    ],
    stl: "none",
    ldflags: ["-Wl,--export-dynamic-symbol=ioctl"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-DTHPD_RECOVERY",
    ],
}

prebuilt_etc {
    name: "init.recovery.goodix-touch.rc",
    src: "init.recovery.goodix-touch.rc",
    sub_dir: "init",
    recovery: true,
}
