// Dolby Vision service
android_app {
    name: "LenovoDolbyVision",

    srcs: ["src/**/*.java"],
    static_libs: ["vendor.dolby.dvs-V1-java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    // Hidden APIs
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,

}
