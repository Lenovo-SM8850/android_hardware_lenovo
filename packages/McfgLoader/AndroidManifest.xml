<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.miner7222.mcfg" android:sharedUserId="android.uid.system">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_ACTIVE_EMERGENCY_SESSION" />
    <application android:label="@string/app_name" android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true" android:allowBackup="false">
        <receiver android:name=".BootReceiver" android:exported="true"
            android:permission="android.permission.MODIFY_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.telephony.action.SIM_APPLICATION_STATE_CHANGED" />
                <action android:name="android.telephony.action.SIM_CARD_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <service android:name=".McfgCoordinatorService" android:exported="false" />
        <activity android:name=".McfgStatusActivity" android:exported="true"
            android:theme="@style/Theme.SubSettingsBase.Expressive" />
    </application>
</manifest>
