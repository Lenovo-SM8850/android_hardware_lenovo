// SPDX-License-Identifier: Apache-2.0
android_app {
    name: "LenovoMcfgLoader",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    static_libs: [
        "vendor.lenovo.hardware.mcfg-V2-java",
        "SettingsLib",
        "androidx.preference_preference",
    ],
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-io.github.miner7222.mcfg",
    system_ext_specific: true,
    src: "privapp-permissions-io.github.miner7222.mcfg.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}
