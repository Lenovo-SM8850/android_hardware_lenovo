// SPDX-License-Identifier: Apache-2.0

android_app {
    name: "io.github.miner7222.datasim",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-io.github.miner7222.datasim",
    system_ext_specific: true,
    src: "privapp-permissions-io.github.miner7222.datasim.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}

java_test_host {
    name: "DataSimPolicyTests",
    srcs: [
        "src/io/github/miner7222/datasim/FirstBootPolicy.java",
        "tests/**/*.java",
    ],
    static_libs: ["junit"],
    test_suites: ["general-tests"],
}
