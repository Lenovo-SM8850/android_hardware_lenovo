// SPDX-License-Identifier: Apache-2.0

android_app {
    name: "LenovoPen",
    srcs: [
        "src/**/*.kt",
    ],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    required: ["default-permissions_io.github.miner7222.pen"],
    static_libs: [
        "vendor.lineage.touch-V1-java",
    ],
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "default-permissions_io.github.miner7222.pen",
    system_ext_specific: true,
    src: "default-permissions_io.github.miner7222.pen.xml",
    sub_dir: "default-permissions",
    filename_from_src: true,
}
