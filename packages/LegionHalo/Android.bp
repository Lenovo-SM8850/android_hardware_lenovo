// SPDX-License-Identifier: Apache-2.0

android_app {
    name: "LenovoLegionHalo",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    required: ["preinstalled-packages-lenovo.xml"],
    static_libs: [
        "vendor.lenovo.hardware.lightring-V1-java",
        "androidx.preference_preference",
        "androidx.palette_palette",
        "SettingsLib",
    ],
    optimize: { enabled: false },
}

prebuilt_etc {
    name: "preinstalled-packages-lenovo.xml",
    src: "preinstalled-packages-lenovo.xml",
    sub_dir: "sysconfig",
    product_specific: true,
}
