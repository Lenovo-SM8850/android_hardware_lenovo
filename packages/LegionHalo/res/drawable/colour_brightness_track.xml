<!-- The end colour is replaced with the selected hue and saturation at runtime. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/colour_picker_dark"
        android:endColor="@color/colour_picker_light" />
    <corners android:radius="@dimen/colour_picker_track_radius" />
    <size android:height="@dimen/colour_picker_track_height" />
</shape>
