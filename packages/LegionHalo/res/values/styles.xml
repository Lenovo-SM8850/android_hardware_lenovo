<resources>
    <!-- Applied on top of the activity theme so every dialog of this app uses the same theme. -->
    <style name="ThemeOverlay.Halo" parent="">
        <item name="alertDialogTheme">@style/Theme.Halo.AlertDialog</item>
    </style>

    <style name="Theme.Halo.AlertDialog" parent="@style/Theme.AlertDialog.SettingsLib.Expressive">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Halo.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Halo.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Halo.DialogButton</item>
        <item name="listPreferredItemHeightSmall">56dp</item>
    </style>

    <!-- Text button: 40dp container inside a 48dp touch target, 14sp label. -->
    <style name="Widget.Halo.DialogButton" parent="@style/Widget.SettingsLib.DialogButton">
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:background">@drawable/halo_dialog_button_background</item>
        <item name="android:textColor">@color/halo_dialog_button_text</item>
    </style>
</resources>
