<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/settingslib_expressive_space_small4"
        android:paddingStart="?attr/dialogPreferredPadding"
        android:paddingEnd="?attr/dialogPreferredPadding">

        <TextView
            android:id="@+id/colour_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SettingsLib.HeadlineSmall"
            android:textColor="@color/settingslib_materialColorOnSurface" />

        <io.github.miner7222.halo.ColourWheelView
            android:id="@+id/colour_wheel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/colour_picker_wheel_size"
            android:layout_marginTop="@dimen/settingslib_expressive_space_small1" />

        <SeekBar
            android:id="@+id/colour_brightness"
            android:layout_width="match_parent"
            android:layout_height="@dimen/colour_picker_slider_height"
            android:max="100"
            android:splitTrack="false"
            android:progressDrawable="@drawable/colour_brightness_track"
            android:thumb="@drawable/colour_brightness_thumb"
            android:contentDescription="@string/brightness" />

        <include layout="@layout/colour_picker_code" />

        <include layout="@layout/colour_picker_buttons" />
    </LinearLayout>
</ScrollView>
