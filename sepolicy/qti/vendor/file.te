# Shared Lenovo touchscreen procfs type
type proc_tp, fs_type, proc_type;

# NVT nodes split by owner; proc_tp remains for the stock pen/game HAL.
type vendor_proc_nvt_gesture, fs_type, proc_type;
type vendor_proc_nvt_polling, fs_type, proc_type;
type vendor_proc_nvt_rotation, fs_type, proc_type;

# Stock Lenovo battery setters and DP mode/hotplug controls.
type vendor_sysfs_lenovo_battery_control, fs_type, sysfs_type;
type vendor_sysfs_lenovo_dp, fs_type, sysfs_type;
type vendor_sysfs_lenovo_charging_control, fs_type, sysfs_type;

# Goodix THP host device nodes.
type thp_device, dev_type;
type input_agent_device, dev_type;
type vendor_sysfs_thp_screen_state, fs_type, sysfs_type;
