
type hal_thp_default, domain;
type hal_thp_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_thp_default)

allow hal_thp_default thp_device:chr_file { getattr open read write ioctl map };
allowxperm hal_thp_default thp_device:chr_file ioctl { 0xb801-0xb812 0xb814 };
allow hal_thp_default input_agent_device:chr_file { getattr open read write ioctl };
allowxperm hal_thp_default input_agent_device:chr_file ioctl { 0xb901-0xb906 };

# TSC owns the screen-state/control netlink thread and requests SCHED_FIFO.
allow hal_thp_default self:netlink_generic_socket { create getattr bind read write };
allow hal_thp_default self:capability sys_nice;

r_dir_file(hal_thp_default, vendor_firmware_file)

# TSC samples fg1_temp every two seconds.
allow hal_thp_default vendor_sysfs_battery_supply:file { getattr open read };

# One startup screen-state reconciliation after the stock cmd101 handshake.
allow hal_thp_default vendor_sysfs_graphics:dir search;
allow hal_thp_default vendor_sysfs_graphics:file { getattr open read };
allow hal_thp_default vendor_sysfs_thp_screen_state:file { getattr open write };
