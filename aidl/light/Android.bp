cc_binary {
    name: "android.hardware.light-service.lenovo",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.light-service.lenovo.rc"],
    vintf_fragments: ["android.hardware.light-service.lenovo.xml"],
    srcs: [
        "Aw22xxx.cpp",
        "Lights.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.light-V2-ndk",
        "vendor.lenovo.hardware.lightring-V1-ndk",
        "libbase",
        "libbinder_ndk",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
