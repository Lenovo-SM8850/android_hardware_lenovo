<compatibility-matrix version="9.0" type="framework">
    <hal format="aidl" optional="true">
        <name>vendor.dolby.dvs</name>
        <version>1</version>
        <interface>
            <name>IDvs</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.battery</name>
        <version>1-5</version>
        <interface>
            <name>IBattery</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.display</name>
        <version>1</version>
        <interface>
            <name>IDisplay</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.led</name>
        <version>1-2</version>
        <interface>
            <name>ILed</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.touchscreen</name>
        <version>1-5</version>
        <interface>
            <name>ITouchscreen</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.ufs</name>
        <version>1</version>
        <interface>
            <name>IUfs</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>vendor.dolby.dvs</name>
        <version>1.0</version>
        <version>1.1</version>
        <interface>
            <name>IDvs</name>
            <instance>dvs-hal-service</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>vendor.lenovo.hardware.vibrator_dual</name>
        <interface>
            <name>IVibratorDual</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.goodix.hardware.biometrics.fingerprint.cap</name>
        <version>1</version>
        <interface>
            <name>IGoodixFingerprintDaemon</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
